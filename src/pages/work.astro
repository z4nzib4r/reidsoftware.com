---
import Layout from '../layouts/Layout.astro';
import CaseStudies from '../components/CaseStudies.astro';
import ServicesList from '../components/ServicesList.astro';
import Testimonial from '../components/Testimonial.astro';
---

<Layout
  title="Cutting-Edge Case Studies | Digital Strategy, Development, & AI Integration Services | Reid Software"
  description="Delve into our case studies and explore how our innovative solutions in digital strategy, product design, development, and AI integrations have driven digital transformation success for businesses like yours."
>
  <div id="projects-page" class="services-page">

      <div id="hero-section">
          <video id="hero-video" width="100%" height="auto" poster="" muted loop autoplay>
              <source src="/assets/video/bg-video-med.mp4" type="video/mp4">
              Your browser does not support the video tag.
          </video>
          <!-- <img id="hero-img" src="/assets/img/hero/hero.jpg" /> -->
          <div id="hero-overlay"></div>
          <div class="container">
              <div class="row justify-content-start">
                  <div class="col-12 col-md-11 col-lg-10">
                      <div class="hero-content">
                          <h1>Our Work</h1>
                          <p class="hero-tagline">Explore our showcase of cutting-edge digital solutions, where our wide array of expertise seamlessly merges to redefine possibilities.</p>
                      </div>
                  </div>
              </div>
          </div>
      </div>


      <div id="case-studies" class="project-highlight">
          <CaseStudies />
      </div>

      <Testimonial index={8} />

      <ServicesList />

  </div>
</Layout>
